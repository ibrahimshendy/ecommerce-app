{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "categories": {
      "type": "array",
      "items": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer"
            },
            "name": {
              "type": "string"
            },
            "slug": {
              "type": "string"
            },
            "sort": {
              "type": "integer"
            },
            "description": {
              "type": "string"
            },
            "created_at": {
              "type": "string"
            }
          },
          "required": ["id", "name", "slug", "created_at"]
        }
      ]
    }
  },
  "required": ["categories"]
}